# Generated media and Python caches are reproducible and grow quickly.
output/
scripts/__pycache__/
*.pyc
.tools/
.venv/

# Keep credentials and local environment overrides out of Git.
.env
.env.*
!.env.example

# Local tool and operating-system files.
.codex/
.agents/
.DS_Store
Thumbs.db

# Media is large and re-fetchable (clips/sources.json, photos/sources.json); keep it out of Git.
clips/*.mp4
clips/*.mov
clips/*.m4v
photos/rotation/*.jpg
photos/rotation/*.jpeg
photos/rotation/*.png
*.part
.cache/
